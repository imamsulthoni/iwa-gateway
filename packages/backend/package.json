{
  "name": "@wa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:api & pnpm run dev:worker",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:key": "tsx src/db/seed/api-key.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@wa/shared": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bullmq": "6.7.6",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "ioredis": "6.0.0",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
