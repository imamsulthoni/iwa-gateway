# Satu-satunya template env. Salin ke .env di root, jangan buat env di packages/.
NODE_ENV=development
PORT=8467
DATABASE_URL=mysql://wbc:root@localhost:3306/wa_console
DATABASE_URL_TEST=mysql://wbc:root@localhost:3306/wa_console_test
REDIS_URL=redis://localhost:6379
# 32 byte base64. Ganti dengan: openssl rand -base64 32
AUTH_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGIN=http://localhost:8468
BROWSER_NAME=WA Bot Console
SESSION_LOCK_TTL_MS=30000
RATE_LIMIT_PER_MIN=240
# Pause otomatis broadcast bila rasio gagal melewati nilai ini (0-1).
BROADCAST_AUTO_PAUSE_RATIO=0.2
# Izinkan URL webhook http:// ke IP privat (10/8, 172.16/12, 192.168/16). Default false.
WEBHOOK_ALLOW_HTTP_PRIVATE=false
# Opsional: set ke `logs` agar log JSON juga ditulis ke logs/api.log dan logs/worker.log.
# LOG_DIR=logs
VITE_API_BASE_URL=http://localhost:8467
