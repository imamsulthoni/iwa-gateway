# Template env stack produksi (docker-compose.prod.yml). Salin ke `.env.prod`.
# File `.env.prod` di-gitignore; file ini tidak boleh berisi secret asli.
#
# Satu file dipakai dua kali:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#   - `--env-file`  -> interpolasi ${...} di compose (termasuk build args)
#   - `env_file:`   -> environment runtime container api/worker

# ---------- Interpolasi compose (wajib, memakai :?) ----------
# mysql:8.0 hanya membaca ini saat volume `mysql_data` pertama kali dibuat.
# Mengubahnya setelahnya tidak mengganti password user yang sudah ada.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=wbc
MYSQL_PASSWORD=
# Dipakai untuk environment PORT, ports:, dan target healthcheck sekaligus.
API_PORT=8467

# ---------- Runtime container ----------
NODE_ENV=production
PORT=8467
# Host memakai nama service compose, bukan localhost. Path DB harus `wa_console`
# karena MYSQL_DATABASE dipaku di compose.
DATABASE_URL=mysql://wbc:CHANGE_ME@mysql:3306/wa_console
REDIS_URL=redis://redis:6379
# 32 byte base64: `openssl rand -base64 32`. Simpan cadangannya — kalau hilang,
# auth state sesi di database tidak bisa didekripsi dan semua sesi harus scan QR ulang.
AUTH_ENC_KEY=
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jakarta
# Origin dashboard, dipisah koma bila lebih dari satu (8468 = vite dev, 8469 = preview).
CORS_ORIGIN=http://localhost:8469
BROWSER_NAME=WA Bot Console
SESSION_LOCK_TTL_MS=30000
RATE_LIMIT_PER_MIN=240
BROADCAST_AUTO_PAUSE_RATIO=0.2
WEBHOOK_ALLOW_HTTP_PRIVATE=false
# Biarkan nonaktif: container tidak punya volume log, isinya hilang saat container diganti.
# LOG_DIR=logs

# ---------- Build-time: dibakar ke bundle web saat `pnpm build` ----------
# Harus URL yang bisa dijangkau browser pengguna, bukan `http://api:8467`.
VITE_API_BASE_URL=http://localhost:8467

# ---------- Opsional ----------
# Path env_file runtime bila ingin memakai file berbeda dari .env.prod.
# APP_ENV_FILE=.env.prod
